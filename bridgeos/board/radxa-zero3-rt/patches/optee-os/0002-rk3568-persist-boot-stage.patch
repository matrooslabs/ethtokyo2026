+void platform_boot_stage(uint32_t stage)
+{
+    vaddr_t base = PMUGRF_BASE;
+
+    if (cpu_mmu_enabled()) {
+        base = (vaddr_t)phys_to_virt_io(PMUGRF_BASE, PMUGRF_SIZE);
+        if (!base)
+            panic("PMUGRF base not mapped");
+    }
+    io_write32(base + PMUGRF_OS_REG11, OPTEE_STAGE_MAGIC | (stage & 0xff));
+}
+
+static TEE_Result mark_boot_complete(void)
+{
+    platform_boot_stage(0xff);
+    return TEE_SUCCESS;
+}
+boot_final(mark_boot_complete);
 
