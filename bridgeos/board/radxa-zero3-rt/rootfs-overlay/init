#!/bin/sh
# Kernel init=/init: mount only the API filesystems needed by early userspace.
set -eu
mountpoint -q /proc 2>/dev/null || mount -t proc proc /proc
mountpoint -q /sys 2>/dev/null || mount -t sysfs sysfs /sys
mountpoint -q /dev 2>/dev/null || mount -t devtmpfs devtmpfs /dev
mkdir -p /run
mountpoint -q /run 2>/dev/null || mount -t tmpfs -o mode=0755 tmpfs /run
# Keep early boot visible on UART2; suppress routine kernel console output at runtime.
[ ! -w /proc/sys/kernel/printk ] || printf '3\n' > /proc/sys/kernel/printk
exec /sbin/init
