# Sui proof stack: copy to .env.sui at the repository root.
# Load in each terminal from the repository root:
#   set -a
#   . ./.env.sui
#   set +a
# Commands: docs/environment.md#sui-proof-stack
# Quote values containing spaces, #, $, or shell metacharacters.
# These SUI_* values are passed as CLI flags by the documented commands;
# the existing binaries and end-to-end script do not read them directly.

# ---- Sui network used by the end-to-end script ----
SUI_NETWORK=testnet
# gRPC-compatible fullnode endpoint, consumed by SuiGrpcClient.
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# Per-transaction budget in MIST, not a total spending limit.
SUI_GAS_BUDGET=3000000000
# Small demo input and committed-trace proof mode.
SUI_E2E_CASE=bench4
SUI_E2E_MODES=b

# Localnet alternative: change these three values together.
# SUI_NETWORK=localnet
# SUI_RPC_URL=http://127.0.0.1:9000
# SUI_GAS_BUDGET=8000000000
# SUI_E2E_CASE=bench3000
# SUI_E2E_MODES=a,b

# ---- Sui HTTP prover ----
SUI_PROVER_BIND=127.0.0.1:8092
SUI_SRS_FILE=scoring/gkr-scoring-sui/artifacts/dev-srs-24.bin
# Optional on loopback; required for external binds. Use at least 32 bytes.
# This variable is read directly by the HTTP server.
# Leave UNSET (not empty) when disabling authentication.
# PROVER_API_TOKEN='replace-with-a-random-token-at-least-32-bytes-long'

# ---- Signing and deployment ----
# Testnet uses the active Sui CLI Ed25519 account from the default keystore:
# ~/.sui/sui_config/sui.keystore. Fund that account with testnet SUI.
# Localnet creates a fresh account and requests funds from the local faucet.
# No SUI_PRIVATE_KEY variable is supported by the current script.
# Each end-to-end run publishes a NEW package and creates a NEW registry;
# package/registry IDs are printed by the script, not supplied through env vars.

# ---- Current integration scope ----
# The web competition, paid scoring routes, and indexer are EVM-only.
# There are no supported VITE_SUI_* or Sui leaderboard variables yet.
# This template configures the Sui proving/on-chain verification stack only.
