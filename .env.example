# Shared environment for the app. Copy to .env at the repository root.
# In each terminal, from the repository root, load before starting a component:
#   set -a
#   . ./.env
#   set +a
# Startup commands and remaining prerequisites: docs/environment.md
# Quote values containing spaces, #, $, or shell metacharacters.

# ---- Chain: indexer and deployment/chart-registration scripts ----
# These public defaults describe the committed Sepolia demo deployment.
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
LEADERBOARD_ADDRESS=0x35319a0232dfe355d1ab26641d0f77482b3ea1dd
DEPLOYMENT_BLOCK=11784156

# ---- Web app: every VITE_* value is exposed to the browser ----
# Keep address/chain consistent with the backend. Use a browser-safe RPC URL;
# do not copy private backend RPC credentials into VITE_SEPOLIA_RPC_URL.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_LEADERBOARD_ADDRESS=0x35319a0232dfe355d1ab26641d0f77482b3ea1dd
VITE_LEADERBOARD_INDEXER_URL=http://127.0.0.1:8787
VITE_SCORING_URL=http://127.0.0.1:8091
VITE_BEATMAP_URL=/beatmaps/daily-demo.osz
# Fill to enable phone-wallet QR; extension wallets work without it.
VITE_WALLETCONNECT_PROJECT_ID=893143aea3b76ea61b6e9aaa77c0d26f
# Local Anvil only: also update CHAIN_ID, RPC_URL, both leaderboard addresses,
# DEPLOYMENT_BLOCK, and the scoring config's manifest/rpcUrl for your local deployment.
# VITE_DEVELOPMENT_CHAIN_ID=31337
# VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
# VITE_DEVELOPMENT_BEATMAP_URL=/beatmaps/daily-demo.osz
# Optional frontend build settings; leave VITE_PRERENDER unset for normal builds.
# VITE_BASE_URL=/Web-Osu-Mania
# VITE_PRERENDER=true

# ---- Read-only indexer (run from repository root) ----
# HOST and PORT belong to the indexer, not the Rust servers.
HOST=127.0.0.1
PORT=8787
DB_PATH=leaderboard/indexer/data/leaderboard.sqlite
CONFIRMATIONS=2
BATCH_SIZE=100
POLL_MS=5000
CORS_ORIGIN=http://localhost:3000
# METADATA_PATH=leaderboard/indexer/charts.json

# ---- Paid scoring HTTP server ----
# Copy scoring/config.example.json to this ignored path and edit it.
# JSON owns rpcUrl, manifest, allowedOrigins, relayerKeyFile, captureMode,
# hardwareUrl/hardwareToken or demoDeviceKeyFile, charts and measured buffer.
# Bind address and SRS are passed as CLI flags, not duplicated in JSON.
SCORING_CONFIG=scoring/data/config.json
# Raw proof client URL for operator smoke scripts.
PROVER_URL=http://127.0.0.1:8091

# ---- EVM prover and deployment/chart-registration scripts ----
# Paths resolve from the repository root. Key contents stay in local files.
KEY_FILE=./.priv-key
PROVER_BINARY=scoring/target/release/mania-gkr
SRS_FILE=scoring/gkr-scoring/artifacts/dev-srs-22.bin
VK_FILE=scoring/gkr-scoring/artifacts/forge/vk.json
# Explicit opt-in needed only when deploying with the known-tau demo SRS.
# ALLOW_INSECURE_DEMO_SRS=1
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# DEPLOYMENT_FILE differs by command: deploy/smoke use the private journal;
# register-chart uses the public .manifest.json. Leave unset for chain defaults.
# DEPLOYMENT_FILE=/absolute/path/to/the-command-specific-file.json
# CHART_OUTPUT=scoring/data/registered.chart.json

# ---- Standalone EVM and Sui HTTP provers ----
# BIND/SUI_SRS_FILE below are passed as CLI flags by docs/environment.md.
# The servers do not read those variables directly.
EVM_PROVER_BIND=127.0.0.1:8091
SUI_PROVER_BIND=127.0.0.1:8092
SUI_SRS_FILE=scoring/gkr-scoring-sui/artifacts/dev-srs-24.bin
# Optional on loopback; required for external raw-only binds (at least 32 bytes).
# Paid competition routes remain loopback-only.
# Export the same token to the scoring server and its operator clients.
# Leave UNSET (not empty) when disabling authentication.
# PROVER_API_TOKEN='replace-with-a-random-token-at-least-32-bytes-long'

# Sui network scripts use CLI flags and the active Sui CLI wallet/keystore.
# No additional app environment variables are required for those scripts.
# Legacy OSU_API_* and TRUST_CF_CONNECTING_IP entries are omitted: the current
# application code does not read them.
