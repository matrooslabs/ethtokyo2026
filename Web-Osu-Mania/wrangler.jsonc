{
    "$schema": "node_modules/wrangler/config-schema.json",
    "main": "@tanstack/react-start/server-entry",
    "name": "webosumania",
    "compatibility_date": "2025-05-18",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "vars": {
        "WORLD_ID_APP_ID": "app_3b09fd5fe1c151bd37b19ceb95c45170",
        "WORLD_ID_RP_ID": "rp_78581d63ee7bed85",
        "WORLD_ID_ACTION": "versu-prize-claim",
        "WORLD_ID_ENVIRONMENT": "production"
    },
    "kv_namespaces": [
        {
            "binding": "OSU_API",
            "id": "4c393a66c157468282b7e336b1627cd6"
        },
        {
            "binding": "BEATMAP_SETS",
            "id": "e24512f619c648009717ac1c53a9f685"
        },
        {
            "binding": "BEATMAP_SET_DATA",
            "id": "db5d38d39f9b497f994b4783b226b338"
        }
    ],
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": [
                "ApiRateLimit"
            ]
        },
        {
            "tag": "v2",
            "deleted_classes": [
                "ApiRateLimit"
            ]
        },
    ],
    "observability": {
        "logs": {
            "enabled": true
        }
    }
}