# Get these values by following these instructions: https://osu.ppy.sh/docs/index.html#registering-an-oauth-application
OSU_API_CLIENT_ID=
OSU_API_CLIENT_SECRET=

# Optional. If deploying to a service that uses shared IP addresses (e.g. Cloudflare Workers),
# you may be rate-limited by other people's osu API requests which can be avoided by using a proxy with a dedicated IP address.
OSU_API_PROXY_URL=
OSU_API_PROXY_KEY=

# Ratelimit
TRUST_CF_CONNECTING_IP=true # Set to false if not behind Cloudflare

# Public browser configuration. Use the SAME network, package and round as the server.
VITE_SUI_NETWORK=testnet
VITE_SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
VITE_SUI_PACKAGE_ID=
VITE_SUI_REGISTRY_ID=
VITE_SUI_CHALLENGE_ID=
VITE_SUI_EASY_CHART_HASH=0xaeb24d9f22f715fa38a9e49d4ed081dd0ccad286b9b14fecaa6cfeb5118d3f92
VITE_SUI_HARD_CHART_HASH=0xceb6d1b65e81eec7b10153e455fcbd376a7f8ab8a30f8ae678b4f13d2e28de75
VITE_SUI_USDC_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
# Reown project ID: enables WalletConnect pairing QR for Sui remote mobile signing.
VITE_WALLETCONNECT_PROJECT_ID=
# Paid Easy/Hard use Forest of Clock; free practice uses bundled /beatmaps/daily-demo.osz.
VITE_BEATMAP_URL=/beatmaps/forest.osz
# Provisional testnet safety reserve after the 139-second Forest chart. Measure real
# Bridge capture + proof + Sui confirmation latency before activating the six-hour challenge.
VITE_SUI_PROOF_BUFFER_SECONDS=900

# PRIVATE Cloudflare Worker bindings: use wrangler secrets, not VITE_ values.
# WORLD_ID_APP_ID, WORLD_ID_RP_ID, WORLD_ID_RP_SIGNING_KEY, WORLD_ID_ACTION,
# WORLD_ID_ENVIRONMENT, SUI_NETWORK, SUI_RPC_URL, SUI_IDENTITY_PRIVATE_KEY,
# SUI_IDENTITY_PACKAGE_ID, SUI_IDENTITY_COIN_TYPE, SUI_IDENTITY_CHALLENGES,
# SUI_SCORING_ORIGIN, SUI_SCORING_API_TOKEN.
# Bind a real D1 database as WORLD_ID_DB and apply migrations/0001_world_identity.sql.
