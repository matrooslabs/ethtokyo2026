# Get these values by following these instructions: https://osu.ppy.sh/docs/index.html#registering-an-oauth-application
OSU_API_CLIENT_ID=
OSU_API_CLIENT_SECRET=

# Optional. If deploying to a service that uses shared IP addresses (e.g. Cloudflare Workers),
# you may be rate-limited by other people's osu API requests which can be avoided by using a proxy with a dedicated IP address.
OSU_API_PROXY_URL=
OSU_API_PROXY_KEY=

# Ratelimit
TRUST_CF_CONNECTING_IP=true # Set to false if not behind Cloudflare

# Public browser configuration only. Never put private keys here.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_LEADERBOARD_ADDRESS=
VITE_LEADERBOARD_INDEXER_URL=http://127.0.0.1:8787
VITE_PROVER_BRIDGE_URL=http://127.0.0.1:8788
# Original short playable demo; replace with a registered archive to use another chart.
VITE_BEATMAP_URL=/beatmaps/daily-demo.osz
# Required for phone wallet QR. Register the deployed app origin in WalletConnect.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional local development only (ignored by production builds).
# VITE_DEVELOPMENT_CHAIN_ID=31337
# VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
# VITE_DEVELOPMENT_BEATMAP_URL=/beatmaps/daily-demo.osz
