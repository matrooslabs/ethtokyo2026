# Copy to .env, fill public configuration, then: set -a; source .env; set +a
# Signing keys stay in an encrypted Foundry keystore or hardware wallet.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SENDER_ADDRESS=0x969e3EB1FE56a525E6D87b1A39D3C0AeDe696d75
FOUNDRY_ACCOUNT=sepolia-deployer

# Paths below are relative to contracts/, where the Foundry scripts run.
VKEY_FILE=../artifacts/vkey.json
MANIA_VERIFIER=
DEVICE_SIGNER=
BITSTREAM_HASH=
PLAYER_ADDRESS=
MATCH_ID=
CHART_HASH=
SESSION_EXPIRES_AT=
SESSION_ID=
SESSION_FILE=../artifacts/sepolia-session.json
PROOF_FILE=../artifacts/sepolia-proof/proof.json
DEVICE_SIGNATURE_FILE=../artifacts/device-signature.json
